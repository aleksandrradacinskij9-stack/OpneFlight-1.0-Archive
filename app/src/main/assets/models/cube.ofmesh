# OpenFlight mesh format - unit cube (CCW winding)

# Bottom face (-Y)
v -1.0 0.0 -1.0
v -1.0 0.0  1.0
v  1.0 0.0  1.0

v -1.0 0.0 -1.0
v  1.0 0.0  1.0
v  1.0 0.0 -1.0

# Top face (+Y)
v -1.0 1.0 -1.0
v  1.0 1.0 -1.0
v  1.0 1.0  1.0

v -1.0 1.0 -1.0
v  1.0 1.0  1.0
v -1.0 1.0  1.0

# Front face (-Z)
v -1.0 0.0 -1.0
v  1.0 1.0 -1.0
v -1.0 1.0 -1.0

v -1.0 0.0 -1.0
v  1.0 0.0 -1.0
v  1.0 1.0 -1.0

# Back face (+Z)
v  1.0 0.0  1.0
v  1.0 1.0  1.0
v -1.0 1.0  1.0

v  1.0 0.0  1.0
v -1.0 1.0  1.0
v -1.0 0.0  1.0

# Right face (+X)
v  1.0 0.0 -1.0
v  1.0 1.0 -1.0
v  1.0 1.0  1.0

v  1.0 0.0 -1.0
v  1.0 1.0  1.0
v  1.0 0.0  1.0

# Left face (-X)
v -1.0 0.0 -1.0
v -1.0 1.0 -1.0
v -1.0 1.0  1.0

v -1.0 0.0 -1.0
v -1.0 1.0  1.0
v -1.0 0.0  1.0